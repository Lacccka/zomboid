require "Gun_Vars/Weapon_Ability/AWCWF_Exact_RPM"

-- =============================================================================
-- RC5 HANDGUN PROBE - ROUND H3                     TEMPORARY MEASUREMENT BUILD
-- =============================================================================
-- Restore from ExactAutomaticRPM.lua.pre_rc5_handgun_h1.bak before release.
--
-- WHERE H1 AND H2 LEFT IT
--   H1: cyclic 1.0-3.2 on 12 handguns -> no rate change whatsoever.
--   H2: SwingTime headroom ruled out by matched pairs.
--   Re-reading RPM_CALIBRATION.csv then showed the whole system is QUANTISED:
--   every one of 110 long-gun intervals is a whole number of 60 Hz frames.
--   Achievable rates are 3600/n only - 1800/1200/900/720/600/514/450/400/360/300.
--   Cyclic does not tune the rate; it selects which STEP you land on.
--
-- WHY THIS ROUND EXISTS
--   The production table already runs pistols at cyclic 6.2 and 8.0
--   (G18/M93R = 1140 -> 8.0, SIGP226/MP7/uzi = 950-960 -> 6.2) and the original
--   complaint is that those feel barely faster than single fire. But nobody has
--   ever MEASURED a pistol above 3.2. "Barely faster" is consistent with both
--   "did not move at all" and "moved one step, still slower than the 1140 the
--   GUI promises". Those need different fixes and cannot be told apart by feel.
--
-- DESIGN
--   Six cyclic points, each assigned to a normal/drum PAIR - so every point
--   also validates pair consistency, which H1 and H2 could not.
--   1.0 is the in-session LOW ANCHOR. Without it, six identical high readings
--   could not be distinguished from six points sharing one step. H1 vs H2
--   drifted between sessions, so a historical anchor is not trustworthy.
--   4.0 / 4.5 / 6.2 / 6.8 / 8.0 are the rifle calibration values; for long guns
--   they span 5-frame, 4-frame and 3-frame steps. 5.5 was dropped - it sits
--   mid-plateau for rifles and buys nothing.
--
-- NEW IN THE LOG - read steps, not RPM
--   frames60  = deltaMs * 60/1000     the step, assuming a 60 Hz quantum
--   framesFps = deltaMs * fps/1000    the step against the ACTUAL framerate
--   fps       = getAverageFPS()
--   aiming    = Aiming perk level
--   If frames60 is a clean integer and framesFps is not, the quantum is a fixed
--   60 Hz logic tick and framerate is irrelevant. If the reverse, observable RPM
--   depends on the player's machine and NO table can fix it.
--   aiming is logged because the same untreated handguns sat on 9-10 frames in
--   H1 and 12-13 in H2 - something outside the weapon picks the step, and
--   character skill is the first suspect.
-- =============================================================================

local RPM_DIAG_ROUND = "H4"

-- ROUND H4 - RecoilDelay test. CYCLIC IS FIXED AT 1.0 FOR ALL SIX so that
-- RecoilDelay is the ONLY variable. Base guns were edited in their scripts;
-- the _Drum variants keep the stock value as an in-pair control.
--   G18      1 vs  9      SIGP226  3 vs 9      uzi  5 vs 10
local RPM_DIAG_POINTS = {
    ["G18_cat"]          = { cyclic = 1.0 },  -- RecoilDelay 1  (treated)
    ["G18_cat_Drum"]     = { cyclic = 1.0 },  -- RecoilDelay 9  (control)
    ["SIGP226_cat"]      = { cyclic = 1.0 },  -- RecoilDelay 3  (treated)
    ["SIGP226_cat_Drum"] = { cyclic = 1.0 },  -- RecoilDelay 9  (control)
    ["uzi_cat"]          = { cyclic = 1.0 },  -- RecoilDelay 5  (treated)
    ["uzi_cat_Drum"]     = { cyclic = 1.0 },  -- RecoilDelay 10 (control)
}

local lastWeapon = nil
local warnedWeaponTypes = {}
local rpmDiag = {
    lastSneaking = nil,
    lastSwingMs = nil,
    lastAmmoCount = nil,
    swingCount = 0,
}

local function warnOnce(weaponType, message)
    if warnedWeaponTypes[weaponType] then return end
    warnedWeaponTypes[weaponType] = true
    print("[MFS RPM] weapon=" .. tostring(weaponType) .. " " .. tostring(message))
end

local function isDiagWeapon(weapon)
    return weapon and weapon.getType and RPM_DIAG_POINTS[weapon:getType()] ~= nil
end

local function readFloat(call, fallback)
    local ok, value = pcall(call)
    if ok and type(value) == "number" then return value end
    return fallback
end

local function formatFloat(value)
    return type(value) == "number" and string.format("%.3f", value) or "n/a"
end

local function getAutoShootSpeed(playerObj)
    if not playerObj or not playerObj.getVariableFloat then return nil end
    return readFloat(function()
        return playerObj:getVariableFloat("autoShootSpeed", -1.0)
    end, nil)
end

local function getFps()
    local ok, v = pcall(function() return getAverageFPS() end)
    if ok and type(v) == "number" and v > 0 then return v end
    return nil
end

local function getAiming(playerObj)
    if not playerObj then return nil end
    local ok, v = pcall(function() return playerObj:getPerkLevel(Perks.Aiming) end)
    if ok and type(v) == "number" then return v end
    return nil
end

local function getAmmoCount(weapon)
    if not weapon or not weapon.getCurrentAmmoCount then return nil end
    return readFloat(function() return weapon:getCurrentAmmoCount() end, nil)
end

local function logRPMDiag(playerObj, weapon, reason, details)
    if not isDiagWeapon(weapon) then return end
    local cyclic = weapon.getCyclicRateMultiplier and
        readFloat(function() return weapon:getCyclicRateMultiplier() end, nil) or nil
    local sneaking = playerObj and playerObj.isSneaking and playerObj:isSneaking() or false
    local fireMode = weapon.getFireMode and weapon:getFireMode() or "n/a"
    print("[MFS RPM DIAG] round=" .. RPM_DIAG_ROUND
        .. " weapon=" .. tostring(weapon:getType())
        .. " reason=" .. tostring(reason)
        .. " sneaking=" .. tostring(sneaking)
        .. " fireMode=" .. tostring(fireMode)
        .. " cyclic=" .. formatFloat(cyclic)
        .. " autoShootSpeed=" .. formatFloat(getAutoShootSpeed(playerObj))
        .. " fps=" .. formatFloat(getFps())
        .. " aiming=" .. tostring(getAiming(playerObj) or "n/a")
        .. " recoilDelay=" .. formatFloat(weapon.getRecoilDelay and
               readFloat(function() return weapon:getRecoilDelay() end, nil) or nil)
        .. (details and (" " .. details) or ""))
end

local function applyExactRPM(playerObj, weapon, reason)
    if not weapon or not weapon.IsWeapon or not weapon:IsWeapon() or not weapon:isRanged() then return end

    local weaponType = weapon:getType()
    local diagPoint = RPM_DIAG_POINTS[weaponType]

    local calibration, configuredRPM, calibrationIndex
    if AWCWF_ResolveRPM then
        calibration, configuredRPM, calibrationIndex = AWCWF_ResolveRPM(weapon)
    end
    if not calibration and not diagPoint then return end

    -- Forced measurement value for test weapons; calibrated value otherwise.
    local cyclic = diagPoint and diagPoint.cyclic or calibration.cyclic

    -- BYPASS 1: the RC4 whitelist would reject every uncalibrated candidate.
    if not diagPoint then
        if not AWCWF_IsCalibratedCyclic or not AWCWF_IsCalibratedCyclic(cyclic) then
            warnOnce(weaponType, "rejected uncalibrated cyclic=" .. tostring(cyclic))
            return
        end
    end

    if not weapon.setCyclicRateMultiplier then
        warnOnce(weaponType, "cannot apply calibrated cyclic: setter unavailable")
        return
    end

    local beforeCyclic = diagPoint and weapon.getCyclicRateMultiplier and
        readFloat(function() return weapon:getCyclicRateMultiplier() end, nil) or nil
    local beforeAutoSpeed = diagPoint and getAutoShootSpeed(playerObj) or nil

    weapon:setCyclicRateMultiplier(cyclic)

    local data = weapon:getModData()
    data.AWCWF_ConfiguredRPM = configuredRPM
    data.AWCWF_DisplayRPM = calibration and calibration.displayRPM or nil
    data.AWCWF_AppliedRPM = calibration and calibration.displayRPM or nil
    -- BYPASS 2: record what was actually applied, not the table value.
    data.AWCWF_CalibratedCyclic = cyclic
    data.AWCWF_RPMCalibrationIndex = calibrationIndex
    data.AWCWF_RPMCategory = diagPoint and ("DIAG-" .. RPM_DIAG_ROUND) or "CalibratedRPM"
    data.AWCWF_RPMCategoryScale = 1.0
    data.AWCWF_RPMGlobalScale = 1.0

    if diagPoint then
        logRPMDiag(playerObj, weapon, reason or "apply",
            "configuredRPM=" .. formatFloat(configuredRPM)
            .. " tableCyclic=" .. formatFloat(calibration and calibration.cyclic or nil)
            .. " forcedCyclic=" .. formatFloat(cyclic)
            .. " beforeCyclic=" .. formatFloat(beforeCyclic)
            .. " beforeAutoShootSpeed=" .. formatFloat(beforeAutoSpeed))
    end
end

local function onPlayerUpdate(playerObj)
    if not playerObj then return end
    local weapon = playerObj:getPrimaryHandItem()
    if weapon ~= lastWeapon then
        lastWeapon = weapon
        rpmDiag.lastSneaking = nil
        rpmDiag.lastSwingMs = nil
        rpmDiag.lastAmmoCount = getAmmoCount(weapon)
        rpmDiag.swingCount = 0
        applyExactRPM(playerObj, weapon, "equip")
    end
    if isDiagWeapon(weapon) then
        local sneaking = playerObj:isSneaking()
        if rpmDiag.lastSneaking == nil or sneaking ~= rpmDiag.lastSneaking then
            rpmDiag.lastSneaking = sneaking
            logRPMDiag(playerObj, weapon, "stance-change")
        end
    end
end

local function onWeaponSwing(playerObj, weapon)
    if isDiagWeapon(weapon) then
        local now = getTimestampMs()
        local delta = rpmDiag.lastSwingMs and (now - rpmDiag.lastSwingMs) or nil
        local ammoCount = getAmmoCount(weapon)
        local ammoDelta = rpmDiag.lastAmmoCount and ammoCount and
            (rpmDiag.lastAmmoCount - ammoCount) or nil
        rpmDiag.lastSwingMs = now
        rpmDiag.lastAmmoCount = ammoCount
        rpmDiag.swingCount = rpmDiag.swingCount + 1
        applyExactRPM(playerObj, weapon,
            "swing#" .. tostring(rpmDiag.swingCount)
            .. " deltaMs=" .. (delta and tostring(delta) or "first")
            .. " tickRPM=" .. (delta and delta > 0 and formatFloat(60000 / delta) or "n/a")
            .. " frames60=" .. (delta and formatFloat(delta * 60 / 1000) or "n/a")
            .. " framesFps=" .. (delta and getFps() and formatFloat(delta * getFps() / 1000) or "n/a")
            .. " ammoCount=" .. formatFloat(ammoCount)
            .. " ammoDelta=" .. formatFloat(ammoDelta))
        return
    end
    applyExactRPM(playerObj, weapon, "swing")
end

print("[MFS RPM DIAG] RC5 handgun probe loaded round=" .. RPM_DIAG_ROUND
    .. " RecoilDelay test: cyclic fixed 1.0, RecoilDelay 1/3/5 vs stock 9/9/10")
Events.OnPlayerUpdate.Add(onPlayerUpdate)
Events.OnWeaponSwing.Add(onWeaponSwing)
