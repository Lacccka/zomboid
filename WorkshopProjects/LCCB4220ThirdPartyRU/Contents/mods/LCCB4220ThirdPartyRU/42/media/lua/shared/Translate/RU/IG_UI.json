    "IGUI_Bandits_Speech_ZSSpotted_Male_101_1": "Там! Вижу скурвителя!",
    "IGUI_Bandits_Speech_ZSSpotted_Male_101_2": "Есть! Вижу гноя!",
    "IGUI_Bandits_Speech_ZSSpotted_Male_101_3": "Кого мы тут имеем, блядь!",
    "IGUI_Bandits_Speech_ZSSpotted_Male_101_4": "Блядь, наваливаем их!",
    "IGUI_Bandits_Speech_ZSSpotted_Male_101_5": "Есть! Там!",
    "IGUI_Bandits_Speech_ZSSpotted_Male_101_6": "Сделаю тебе дырку в жопе!",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_1": "Заряжаю ствол",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_2": "Надо перезарядить пушку!",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_3": "Где мои патроны!",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_4": "Блядь, надо перезарядить!",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_5": "Я пиздец! Reload!",
    "IGUI_Bandits_Speech_ZSReloading_Male_101_6": "Я пиздец! Где магазин?",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_1": "Входим!",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_2": "Открывай это говно!",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_3": "Поехали!",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_4": "Наваливаем!",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_5": "Тук! Тук! Блядь!",
    "IGUI_Bandits_Speech_ZSBreach_Male_101_6": "Врываемся на полной!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_1": "Вылезай из тачки!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_2": "Выскакивай из машины!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_3": "Вылезай из брички!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_4": "Выпёздывай наружу!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_5": "Выскакивай! Уже!",
    "IGUI_Bandits_Speech_ZSCar_Male_101_6": "Вылезай, кореш!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_1": "Лежи, пёс!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_2": "Получил!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_3": "Поймал!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_4": "Лёг!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_5": "На землю! Блядь!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_6": "На! Сука!",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_7": "Всё, покончено.",
    "IGUI_Bandits_Speech_ZSDeath_Male_101_8": "На землю! Уже!",
