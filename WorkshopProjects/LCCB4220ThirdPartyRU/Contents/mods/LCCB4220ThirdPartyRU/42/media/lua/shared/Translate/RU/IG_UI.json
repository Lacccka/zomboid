    "IGUI_Bandits_Speech_ZSReloading_Female_3_6": "Меняю магазин!",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_1": "Круши!",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_2": "Разнеси!",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_3": "Открывай дверь!",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_4": "Надо разнести.",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_5": "Взламываем дверь!",
    "IGUI_Bandits_Speech_ZSBreach_Female_3_6": "Я вламываюсь!",
