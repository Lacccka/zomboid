    "IGUI_Bandits_Speech_ZSDragdown_Male_101_3": "!",
    "IGUI_Bandits_Speech_ZSInside_Male_101_1": "Блядь, врываемся в хату!",
    "IGUI_Bandits_Speech_ZSInside_Male_101_2": "Крыса засела внутри.",
    "IGUI_Bandits_Speech_ZSInside_Male_101_3": "Блядь, входим!",
    "IGUI_Bandits_Speech_ZSUpstairs_Male_101_1": "Дебил, сидит наверху!",
    "IGUI_Bandits_Speech_ZSOutside_Male_101_1": "Пусто!",
    "IGUI_Bandits_Speech_ZSOutside_Male_101_2": "Выезд!",
    "IGUI_Bandits_Speech_ZSOutside_Male_101_3": "Вали из бара! Свалил мне!",
    "IGUI_Bandits_Speech_ZSRoom_Kitchen_Male_101_1": "Наверное, сидит на кухне.",
    "IGUI_Bandits_Speech_ZSRoom_Bathroom_Male_101_1": "Наверное, в сортире.",
    "IGUI_Bandits_Speech_ZSDefender_Spot_Male_101_1": "Что за блядь? Вали отсюда!",
    "IGUI_Bandits_Speech_ZSDefender_Spot_Male_101_2": "Гной, вали с моего места!",
    "IGUI_Bandits_Speech_ZSDefender_Spot_Male_101_3": "Блядь! Не тот адрес, убью тебя!",
    "IGUI_Bandits_Speech_ZSDefender_Spot_Male_101_4": "Стук-стук! Вали!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_1": "Ай! Блядь!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_2": "О блядь! Я пиздец!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_3": "Ай!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_4": "А!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_5": "Ух!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_6": "Уа!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_7": "Это больно!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_8": "Чёрт!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_9": "Ты хуй! Убью тебя!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_10": "Аа!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_11": "Уу!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_12": "Сваливай!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_13": "А.. а..!",
    "IGUI_Bandits_Speech_ZSHit_Male_101_14": "А.. а..!",
    "IGUI_Bandits_Speech_ZSThief_Spot_Male_101_1": "Отдавай ствол, гной!",
    "IGUI_Bandits_Speech_ZSThief_Spot_Male_101_2": "Добрый день, блядь! Отдаёшь лут!",
    "IGUI_Bandits_Speech_ZSThief_Spot_Male_101_3": "Забираем хабар!",
    "IGUI_Bandits_Speech_ZSThief_Spot_Male_101_4": "Сгребаем стволы!",
