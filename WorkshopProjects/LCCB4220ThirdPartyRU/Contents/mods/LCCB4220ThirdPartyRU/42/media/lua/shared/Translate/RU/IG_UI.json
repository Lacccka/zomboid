    "IGUI_Bandits_Speech_ZSReloading_Female_4_6": "Давай! Давай!",
    "IGUI_Bandits_Speech_ZSBreach_Female_4_1": "Взламываем!",
    "IGUI_Bandits_Speech_ZSBreach_Female_4_2": "Ломай!",
    "IGUI_Bandits_Speech_ZSBreach_Female_4_3": "Ломай эту дрянь!",
    "IGUI_Bandits_Speech_ZSBreach_Female_4_4": "Разнеси!",
